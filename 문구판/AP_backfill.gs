function AP_backfillPreview() { console.log(AP_backfill_(false)); }
function AP_backfillApply() { console.log(AP_backfill_(true)); }

function AP_backfill_(apply) {
  var sh = SpreadsheetApp.openById(AP.SS_A).getSheetByName(AP.T.judge), J = AP.JUDGE, H = J.head, last = sh.getLastRow();
  AP_checkJudgeHead_(sh);
  if (last <= H) return '내 판정에 행이 없습니다.';
  var byId = {}, hit = {};
  AP_BF.forEach(function (b, i) { (byId[b[0]] = byId[b[0]] || []).push(i); });
  var ids = sh.getRange(H + 1, J.idCol, last - H, 1).getValues(), texts = sh.getRange(H + 1, J.textCol, last - H, 1).getValues();
  var done = [], skipped = [];
  for (var i = 0; i < ids.length; i++) {
    var id = String(ids[i][0]).trim(), list = byId[id]; if (!list) continue;
    var row = i + H + 1, text = String(texts[i][0] || '').trim();
    if (/^\s*\[바로 쓰기 어려움\]/.test(text)) { list.forEach(function (k) { hit[k] = 1; }); skipped.push(row + '행(이미 태그 있음)'); continue; }
    var b = null; list.forEach(function (k) { if (text.slice(0, AP_BF[k][1].length) === AP_BF[k][1]) { hit[k] = 1; if (!b) b = AP_BF[k]; } });
    if (!b) { skipped.push(row + '행(서술이 바뀜)'); continue; }
    var line = '[바로 쓰기 어려움] ' + b[2].join(' · ');
    if (apply) sh.getRange(row, J.textCol).setValue(AP_cell_(line + '\n' + text));
    done.push(row + '행 ' + b[2].join('·'));
  }
  var missing = AP_BF.filter(function (b, k) { return !hit[k]; }).map(function (b) { return b[0]; });
  return (apply ? '태그를 붙였습니다 ' : '붙일 예정 ') + done.length + '행' +
    (skipped.length ? ' · 건너뜀 ' + skipped.length + ': ' + skipped.join(', ') : '') +
    (missing.length ? ' · 시트에서 못 찾은 영상 ' + missing.length + ': ' + missing.join(', ') : '') +
    '\n' + done.join('\n');
}
